#!/bin/bash
# PBS Pro template (qsub). Fill in the queue, resources and walltime for your cluster; the values below are placeholders.
# Submit:  export ARGS="reextract --run <run-id> --extractor ollama:qwen2.5:32b"; qsub -V scripts/hpc/job.pbs
# (Use exported variables with -V: `qsub -v` splits on commas, and the arguments can contain commas.)
#PBS -N mdfaith
#PBS -q CHANGE_ME_gpu_queue
#PBS -l select=1:ncpus=8:ngpus=1:mem=48gb
#PBS -l walltime=06:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR"
# module load cuda    # uncomment / adjust if your cluster needs it for Ollama's bundled CUDA libraries
bash scripts/hpc/run_job.sh $ARGS
